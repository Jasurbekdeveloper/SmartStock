rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && currentUserDoc().data.active == true;
    }

    function currentTenantId() {
      return currentUserDoc().data.tenantId;
    }

    function isTenantMember(tenantId) {
      return isActiveUser() && currentTenantId() == tenantId;
    }

    function isTenantStaff(tenantId) {
      return isTenantMember(tenantId)
        && currentUserDoc().data.role in ['admin', 'manager'];
    }

    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && currentUserDoc().data.role == 'admin';
    }

    // Platform operator. Only the Admin SDK script (scripts/tenant-migration/
    // create-super-admin.mjs) can create platformAdmins docs, so no browser can grant it.
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function tenantDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    // Subscription gate for every store write: trial/active, and paidUntil (if set)
    // not more than GRACE_DAYS (3, see src/app/core/models/saas.ts) in the past.
    // A store past that is read-only: data stays visible and exportable.
    function tenantWritable(tenantId) {
      let t = tenantDoc(tenantId);
      return t.status in ['trial', 'active']
        && (!('paidUntil' in t) || t.paidUntil == null
            || request.time < t.paidUntil + duration.value(3, 'd'));
    }

    function canWrite(tenantId) {
      return isTenantMember(tenantId) && tenantWritable(tenantId);
    }

    function canStaffWrite(tenantId) {
      return isTenantStaff(tenantId) && tenantWritable(tenantId);
    }

    // Role split mirrors src/app/core/auth/permissions.ts: staff (admin/manager) see
    // the whole store; a cashier sees only the sales and shifts they made.
    function isStaffOrOwner(tenantId, ownerUid) {
      return isTenantStaff(tenantId) || (isTenantMember(tenantId) && ownerUid == request.auth.uid);
    }

    function canAdminWrite(tenantId) {
      return isTenantAdmin(tenantId) && tenantWritable(tenantId);
    }

    function storeRole(role) {
      return role in ['admin', 'manager', 'cashier'];
    }

    // Ownership can only move to an active admin of the same store.
    function isActiveAdminOf(uid, tenantId) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.tenantId == tenantId && u.role == 'admin' && u.active == true;
    }

    // tenants/{tenantId}: one store. The super admin creates it and owns the
    // subscription fields; the store's admin may only edit its own contact details.
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if (isSuperAdmin()
          && (request.resource.data.ownerId == resource.data.ownerId
              || isActiveAdminOf(request.resource.data.ownerId, tenantId)))
        || (isTenantAdmin(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'phone', 'address', 'onboarded', 'updatedAt']));
      allow delete: if false;
    }

    // users/{uid}: every employee's profile + role, keyed by their Firebase Auth uid.
    // Store admins manage their own store's staff (incl. other admins) but can never
    // touch the store owner's profile or hand out the superadmin role.
    match /users/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isTenantStaff(resource.data.tenantId) || isSuperAdmin());
      allow create: if storeRole(request.resource.data.role)
        && (isSuperAdmin() && existsAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
            || canAdminWrite(request.resource.data.tenantId));
      allow update: if (isSuperAdmin()
            && storeRole(request.resource.data.role)
            && request.resource.data.tenantId == resource.data.tenantId)
        || (canAdminWrite(resource.data.tenantId)
            && storeRole(request.resource.data.role)
            && request.resource.data.tenantId == resource.data.tenantId
            && uid != tenantDoc(resource.data.tenantId).ownerId)
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if false;
    }

    // platformAdmins/{uid}: written only by the Admin SDK script.
    match /platformAdmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // plans/{id}: subscription plans. Public read: the marketing site lists the
    // plans marked showOnSite (prices are not secret); store admins read their limits.
    match /plans/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // subscriptionPayments/{id}: recorded by the super admin; the store admin sees
    // its own history. Never deleted: a mistaken payment is only marked voided, once.
    match /subscriptionPayments/{id} {
      allow read: if isSuperAdmin() || isTenantAdmin(resource.data.tenantId);
      allow create: if isSuperAdmin() && request.resource.data.recordedBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && resource.data.get('voided', false) == false
        && request.resource.data.voided == true
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['voided', 'voidedAt', 'voidedBy', 'voidedByName']);
      allow delete: if false;
    }

    // platformAudit/{id}: what the super admin did. Immutable.
    match /platformAudit/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // siteContent/main: marketing site texts, lists, contacts and section switches,
    // edited in /platform/site. Public read: website/main.js fetches it over REST.
    match /siteContent/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Optional string field of a new lead: absent, or a string of at most max chars.
    function optionalText(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // leads/{id}: demo requests from the website. Created without sign-in by the
    // leads Cloudflare Worker (worker/), which validates, rate-limits and sends the
    // Telegram message; the shape is enforced here too. The super admin works them:
    // status and notes only.
    match /leads/{id} {
      allow read: if isSuperAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'storeName', 'city', 'storeType',
            'registers', 'message', 'plan', 'lang', 'page', 'status', 'source', 'notified', 'ipHash',
            'userAgent', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('[+][0-9]{9,15}')
        && optionalText(request.resource.data, 'storeName', 100)
        && optionalText(request.resource.data, 'city', 80)
        && optionalText(request.resource.data, 'storeType', 80)
        && optionalText(request.resource.data, 'registers', 4)
        && optionalText(request.resource.data, 'message', 1000)
        && optionalText(request.resource.data, 'plan', 60)
        && optionalText(request.resource.data, 'page', 300)
        && optionalText(request.resource.data, 'ipHash', 64)
        && optionalText(request.resource.data, 'userAgent', 300)
        && (!('lang' in request.resource.data) || request.resource.data.lang in ['uz', 'ru', 'en'])
        && (!('notified' in request.resource.data)
            || (request.resource.data.notified is int && request.resource.data.notified >= 0 && request.resource.data.notified <= 20))
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'notes', 'updatedAt', 'updatedBy', 'tenantId']);
      allow delete: if false;
    }

    // leadRateLimits/{ipHash}: submitLead's per-IP counter (Admin SDK only).
    match /leadRateLimits/{id} {
      allow read, write: if false;
    }

    // telegramLinks/{telegramId}: Telegram account -> uid, maintained only by the
    // linkTelegram/unlinkTelegram Cloud Functions (Admin SDK).
    match /telegramLinks/{telegramId} {
      allow read, write: if false;
    }

    match /categories/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId);
      allow update: if canStaffWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if canStaffWrite(resource.data.tenantId);
    }

    // products/{id}: catalog items. Full edits (name/price/etc.) are admin/manager only;
    // any active staff (incl. cashier) may adjust only quantity/updatedAt, since checkout
    // in the POS decrements stock for every role.
    match /products/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId);
      allow delete: if canStaffWrite(resource.data.tenantId);
      allow update: if (canStaffWrite(resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId)
        || (canWrite(resource.data.tenantId)
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']));
    }

    // stockBatches/{id}: dated batches of products with expiry tracking. Staff create
    // them (stock in, new product, import) and write them off. A sale or return by any
    // active user (cashiers too) may only move the remaining quantity, in the same
    // atomic batch as the sale itself. (No lower bound: two tills selling the last
    // units at once must not make one of the sales fail — same as product stock.)
    match /stockBatches/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId)
        && request.resource.data.quantity is number && request.resource.data.quantity >= 0
        && request.resource.data.expiryDate is timestamp;
      allow update: if (canStaffWrite(resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.productId == resource.data.productId)
        || (canWrite(resource.data.tenantId)
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']));
      allow delete: if canStaffWrite(resource.data.tenantId);
    }

    // stockEntries/{id}: stock in/out/adjustment audit log, managed by admin/manager
    // (the app's UI already restricts these routes to admin/manager).
    match /stockEntries/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId);
      allow update, delete: if false;
    }

    // sales/{id}: POS checkout receipts. Any active staff can create a sale (cashiers
    // run the register). A sale is otherwise immutable — the only change allowed is a
    // return bumping its denormalized refundedAmount, never past the sale total.
    match /sales/{id} {
      allow read: if isStaffOrOwner(resource.data.tenantId, resource.data.get('cashierId', ''));
      allow create: if canWrite(request.resource.data.tenantId)
        && request.resource.data.cashierId == request.auth.uid;
      // Refunds are a manager action (permission sales.refund).
      allow update: if canStaffWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundedAmount'])
        && request.resource.data.refundedAmount <= resource.data.total + 1;
      allow delete: if false;
    }

    // returns/{id}: refunds against a sale (stock goes back, cash/card goes out).
    // Immutable once written; attributed to the active user creating it.
    match /returns/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId)
        && request.resource.data.cashierId == request.auth.uid;
      allow update, delete: if false;
    }

    // customers/{id}: debtor contact info, any active staff can register one.
    match /customers/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      // Cashiers may add a customer at the till (debt sale) but not edit the base.
      allow create: if canWrite(request.resource.data.tenantId);
      allow update: if canStaffWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if canStaffWrite(resource.data.tenantId);
    }

    // debts/{id}: any active staff can open a debt or record a payment against
    // one; only paidAmount/remainingAmount/lastPaymentDate move on update (the
    // original amount and customer stay fixed once created).
    match /debts/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      // A debt sale at the till creates the debt; collecting payments is staff work.
      allow create: if canWrite(request.resource.data.tenantId);
      allow update: if canStaffWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paidAmount', 'remainingAmount', 'lastPaymentDate']);
      allow delete: if canStaffWrite(resource.data.tenantId);
    }

    // shifts/{id}: cashier register sessions (open/close, Z-report). Any active user
    // can read (cashier's own history + admin/manager's cross-cashier view are both
    // filtered client-side); only the cashier who opened a shift may create/close it,
    // and closing may only touch the Z-report fields, not the original open data.
    match /shifts/{id} {
      allow read: if isStaffOrOwner(resource.data.tenantId, resource.data.cashierId);
      allow create: if canWrite(request.resource.data.tenantId)
        && request.resource.data.cashierId == request.auth.uid;
      allow update: if canWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && resource.data.cashierId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','closedAt','countedCash','expectedCash','variance','salesCount','totalRevenue','cashTotal','cardTotal','refundTotal','cashInTotal','cashOutTotal','notes']);
      allow delete: if canAdminWrite(resource.data.tenantId);
    }

    // cashMovements/{id}: cash put into / taken out of a drawer during a shift. Only the
    // cashier who owns the (still open) shift may record one; immutable afterwards so the
    // Z-report stays reproducible. Staff read everything; a cashier reads their own.
    match /cashMovements/{id} {
      allow read: if isStaffOrOwner(resource.data.tenantId, resource.data.cashierId);
      allow create: if canWrite(request.resource.data.tenantId)
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.cashierId == request.auth.uid
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.status == 'open';
      allow update, delete: if false;
    }

    // expenses/{id}: rent, salaries, utilities… for the P&L. Staff only (finance.manage).
    // An expense paid from a till is linked to an immutable cash movement, so its amount
    // can't change afterwards.
    match /expenses/{id} {
      allow read: if isTenantStaff(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if canStaffWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.createdBy == resource.data.createdBy
        && (!('cashMovementId' in resource.data) || request.resource.data.amount == resource.data.amount);
      allow delete: if canStaffWrite(resource.data.tenantId) && !('cashMovementId' in resource.data);
    }

    // suppliers/{id}: purchasing contacts (name/phone/address/etc.). Any signed-in
    // user can read (needed for the stock-in supplier picker); only admin/manager
    // may create/update/delete, matching the stock module's access level.
    match /suppliers/{id} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if canStaffWrite(request.resource.data.tenantId);
      allow update: if canStaffWrite(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if canStaffWrite(resource.data.tenantId);
    }

    // settings/general: VAT rate/currency/store contact info. Public read — the
    // landing page shows the store's phone/address/hours to visitors, and nothing
    // in this doc is secret (that's what settings/integrations is for). Admin-only write.
    // settings/integrations: Telegram bot token/chat ID — admin-only read AND write,
    // kept as a separate doc from `general` so non-admin roles never see the token.
    match /settings/general {
      allow read: if true;
      allow write: if false;
    }
    match /settings/integrations {
      allow read, write: if false;
    }
    match /settings/{tenantId} {
      allow read: if tenantId == 'general' || isTenantMember(tenantId);
      allow write: if tenantId != 'general' && (canAdminWrite(tenantId) || isSuperAdmin());
    }
    match /settingsIntegrations/{tenantId} {
      allow read: if isTenantAdmin(tenantId);
      allow write: if canAdminWrite(tenantId);
    }

    // auditLog/{id}: sensitive-action history (price/stock/role changes, deletes).
    // Any admin/manager may read it; a writer may only create an entry attributed
    // to themselves (userId must match their own uid); it's an immutable record,
    // so no update/delete, ever — not even by admin.
    match /auditLog/{id} {
      allow read: if isTenantStaff(resource.data.tenantId);
      allow create: if canWrite(request.resource.data.tenantId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // notificationState/{id}: one-shot dedup bookkeeping for the low-stock/debt-due
    // Telegram alert check (11-band) — a single doc (`telegram`) mapping
    // productId/debtId to the ISO timestamp it was last alerted on, read+written
    // imperatively via getDoc/setDoc (not a live subscription). Any active user may
    // read/write since any cashier's dashboard load can trigger the check.
    match /notificationState/{id} {
      allow read: if isTenantMember(id) && resource.data.tenantId == id;
      allow write: if canWrite(id) && request.resource.data.tenantId == id;
    }

    // Everything else is default-denied until its module is built and
    // gets its own explicit rules (Orders...).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
